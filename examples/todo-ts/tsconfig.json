{
  "compilerOptions": {
    "moduleResolution": "node",
    "target": "es2019",
    "module": "esnext",
    "jsx": "react",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true
  },
  "include": ["src", "tsconfig.json"]
}
